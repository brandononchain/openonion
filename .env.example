# ── Model provider ────────────────────────────────────────────────────────────
# "openai" = any OpenAI-compatible endpoint (OpenAI, Ollama, vLLM, LM Studio,
# OpenRouter, Together, ...). "anthropic" = Anthropic Messages API.
OPENONION_PROVIDER=openai
OPENONION_MODEL=qwen2.5:14b
OPENONION_BASE_URL=http://host.docker.internal:11434/v1
OPENONION_API_KEY=ollama

# Anthropic example:
# OPENONION_PROVIDER=anthropic
# OPENONION_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=sk-ant-...

# ── Tor ───────────────────────────────────────────────────────────────────────
# Letters and digits only. Generate one with:  openssl rand -hex 24
TOR_CONTROL_PASSWORD=change-me-to-a-long-random-string
TOR_SOCKS_PORTS=9100-9109

# ── API ───────────────────────────────────────────────────────────────────────
# When set, every API call needs "Authorization: Bearer <token>".
OPENONION_API_TOKEN=
# The shell tool is OFF unless you opt in (it always requires approval).
OPENONION_ENABLE_SHELL=false
